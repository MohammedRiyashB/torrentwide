# Copy to .env locally. Never commit real secrets.
TORRENTWIDE_API_TOKEN=replace-with-a-long-random-secret
JWT_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql+psycopg://torrentwide:change-this-db-password@db:5432/torrentwide
POSTGRES_PASSWORD=change-this-db-password
QBITTORRENT_HOST=http://qbittorrent:8080
QBITTORRENT_USER=admin
QBITTORRENT_PASSWORD=replace-with-a-unique-strong-password
TORRENT_DOWNLOAD_PATH=/downloads
CORS_ORIGINS=https://torrentwide.vercel.app,http://localhost:5173
